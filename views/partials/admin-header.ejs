<nav class="admin-main-nav" aria-label="Admin navigation">
  <a href="/admin/projects" class="admin-nav-link<%= currentPath && currentPath.startsWith('/admin/projects') ? ' active' : '' %>">
    <i class="ph ph-database"></i>
    <span>Projects</span>
  </a>

  <% if (user && user.role === 'owner') { %>
    <a href="/admin/users" class="admin-nav-link<%= currentPath && currentPath.startsWith('/admin/users') ? ' active' : '' %>">
      <i class="ph ph-users"></i>
      <span>Users</span>
    </a>
  <% } %>

  <% if (user && (user.role === 'admin' || user.role === 'owner')) { %>
    <a href="/admin/settings" class="admin-nav-link<%= currentPath && currentPath.startsWith('/admin/settings') ? ' active' : '' %>">
      <i class="ph ph-gear"></i>
      <span>Settings</span>
    </a>
  <% } %>
</nav>

<div class="admin-header-spacer"></div>

<details class="header-menu theme-menu">
  <summary class="header-action theme-toggle-btn" aria-label="Color scheme" title="Color scheme">
    <i class="ph ph-moon"></i>
  </summary>

  <div class="header-popover theme-popover">
    <button type="button" class="theme-option" data-theme-value="light">
      <i class="ph ph-sun"></i>
      <span>Light</span>
    </button>
    <button type="button" class="theme-option" data-theme-value="dark">
      <i class="ph ph-moon"></i>
      <span>Dark</span>
    </button>
    <button type="button" class="theme-option" data-theme-value="auto">
      <i class="ph ph-desktop"></i>
      <span>Auto</span>
    </button>
  </div>
</details>

<details class="header-menu user-menu">
  <summary class="header-user">
    <span><%= user ? user.email : 'Guest' %></span>
    <i class="ph ph-caret-down"></i>
  </summary>

  <div class="header-popover user-popover">
    <% if (user && user.role === 'owner') { %>
      <a href="/admin/users" class="header-popover-item">
        <i class="ph ph-users"></i>
        <span>Manage users</span>
      </a>

      <div class="header-popover-divider"></div>
    <% } %>

    <form action="/auth/logout" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="header-popover-item">
        <i class="ph ph-sign-out"></i>
        <span>Logout</span>
      </button>
    </form>
  </div>
</details>
