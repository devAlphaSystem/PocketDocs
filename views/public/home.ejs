<% const _projectCount = Array.isArray(projects) ? projects.length : 0; %>

<div class="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-content">
      <h1 id="home-title" dir="auto"><%- heroTitleHtml %></h1>
      <p class="hero-subtitle" dir="auto"><%- heroSubtitleHtml %></p>
    </div>

    <div class="home-hero-mark" aria-hidden="true">
      <img src="<%= siteIconUrl %>" alt="">
    </div>
  </section>

  <section class="home-projects" aria-labelledby="public-projects-title">
    <div class="home-projects-header">
      <div>
        <span class="home-section-label"><%= t('Public library') %></span>
        <h2 id="public-projects-title"><%= t('Explore projects') %></h2>
      </div>

      <span class="home-project-count"><%= t('{count} project', { count: _projectCount }) %></span>
    </div>

    <% if (_projectCount === 0) { %>
      <div class="empty-state">
        <h2><%= t('No public projects yet') %></h2>
        <p><%= t('Documentation projects will appear here once published.') %></p>
      </div>
    <% } else { %>
      <div class="project-grid">
        <% for (const proj of projects) { %>
          <a href="/docs/<%= proj.slug %>" class="project-card">
            <div class="project-card-header">
              <% if (proj.logo) { %>
                <img src="<%= sitePbUrl %>/api/files/projects/<%= proj.id %>/<%= proj.logo %>" alt="" class="project-logo">
              <% } else { %>
                <h3 class="project-card-title" dir="auto"><%= proj.name %></h3>
              <% } %>

              <span class="project-card-open" aria-hidden="true">
                <i class="ph ph-arrow-up-right"></i>
              </span>
            </div>

            <div class="project-card-body">
              <% if (proj.logo) { %>
                <h3 dir="auto"><%= proj.name %></h3>
              <% } %>

              <% if (proj.description) { %>
                <p dir="auto"><%= proj.description %></p>
              <% } %>
            </div>

            <div class="project-card-footer">
              <span class="project-card-type"><%= t('Documentation') %></span>
              <span class="project-slug" dir="ltr">/<%= proj.slug %></span>
            </div>
          </a>
        <% } %>
      </div>
    <% } %>
  </section>
</div>
