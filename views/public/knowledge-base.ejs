<% const kbCardItems = typeof kbPageItems !== 'undefined' ? kbPageItems : []; %>

<div class="docs-layout">
  <%- include('../partials/docs-sidebar', {
    project,
    version,
    versions,
    pageTree,
    page: null,
    nonVersionedMode: typeof nonVersionedMode !== 'undefined' ? nonVersionedMode : false,
    supportsKnowledgeBase: typeof supportsKnowledgeBase !== 'undefined' ? supportsKnowledgeBase : true,
    kbBaseUrl,
    section,
    knowledgeBaseSectionCounts: typeof knowledgeBaseSectionCounts !== 'undefined' ? knowledgeBaseSectionCounts : {}
  }) %>

  <div class="docs-main">
    <article class="docs-article" id="docs-content" tabindex="-1">
      <% if (typeof kbPage !== 'undefined' && kbPage) { %>
        <div class="docs-article-header">
          <h1 dir="auto"><%= kbPage.title %></h1>

          <% if (kbPage.content_updated) { %>
            <p class="docs-updated-date">
              <%= t('Last updated') %> <time datetime="<%= kbPage.content_updated %>"><%= formatLongDateTime(kbPage.content_updated, publicLocale) %></time>
            </p>
          <% } %>
        </div>

        <div class="docs-content prose" dir="auto" data-copy-label="<%= t('Copy code') %>">
          <%- contentHtml %>
        </div>
      <% } else if (typeof section !== 'undefined' && section) { %>
        <div class="docs-article-header">
          <h1><%= sectionLabel %></h1>
        </div>

        <% if (kbCardItems.length > 0) { %>
          <div class="search-results-list">
            <% for (const node of kbCardItems) { %>
              <a href="<%= kbBaseUrl %>/<%= node.section %>/<%= node.slug %>" class="search-result-card" style="--result-indent: <%= node.depth * 16 %>px">
                <h3>
                  <% if (node.icon) { %>
                    <i class="ph ph-<%= node.icon %>"></i>
                  <% } %>
                  <bdi><%= node.title %></bdi>
                </h3>

                <span class="search-result-slug" dir="ltr">/<%= node.slug %></span>
              </a>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty-state small">
            <h3><%= t('No articles yet') %></h3>
            <p><%= t('No {section} articles have been published.', { section: sectionLabel }) %></p>
          </div>
        <% } %>
      <% } else { %>
        <div class="docs-article-header">
          <h1><%= t('Knowledge Base') %></h1>
        </div>

        <div class="search-results-list">
          <% for (const group of sectionGroups) { %>
            <a href="<%= kbBaseUrl %>/<%= group.value %>" class="search-result-card">
              <h3><i class="ph ph-<%= group.icon %>"></i> <%= t(group.label) %></h3>
              <p><%= t('{count} article', { count: group.pages.length }) %></p>
              <span class="search-result-slug" dir="ltr">/<%= group.value %></span>
            </a>
          <% } %>
        </div>
      <% } %>
    </article>

    <% if (typeof headings !== 'undefined' && headings.length > 0) { %>
      <aside class="docs-toc" aria-label="<%= t('On this page') %>">
        <h2 class="docs-toc-title"><%= t('On this page') %></h2>

        <ul>
          <% for (const h of headings) { %>
            <li class="toc-h<%= h.level %>">
              <a href="#<%= h.id %>">
                <bdi><%= h.text %></bdi>
              </a>
            </li>
          <% } %>
        </ul>
      </aside>
    <% } %>
  </div>
</div>

<script src="<%= assetUrl('/js/search.js') %>"></script>

<script src="<%= assetUrl('/js/version-switcher.js') %>"></script>

<script src="<%= assetUrl('/js/code-copy.js') %>"></script>

<script src="<%= assetUrl('/js/docs-toc.js') %>"></script>

<script src="<%= assetUrl('/js/markdown-checkboxes.js') %>"></script>

<script type="module" src="<%= assetUrl('/js/mermaid-init.js') %>"></script>
