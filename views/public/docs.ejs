<% const _nonVersionedMode = typeof nonVersionedMode !== 'undefined' && nonVersionedMode; %>

<div class="docs-layout">
  <%- include('../partials/docs-sidebar', {
    project,
    version,
    versions,
    pageTree,
    page,
    nonVersionedMode: typeof nonVersionedMode !== 'undefined' ? nonVersionedMode : false,
    supportsKnowledgeBase: typeof supportsKnowledgeBase !== 'undefined' ? supportsKnowledgeBase : false,
    kbBaseUrl: typeof kbBaseUrl !== 'undefined' ? kbBaseUrl : '',
    knowledgeBaseSectionCounts: typeof knowledgeBaseSectionCounts !== 'undefined' ? knowledgeBaseSectionCounts : {}
  }) %>

  <div class="docs-main">
    <article class="docs-article" id="docs-content" tabindex="-1">
      <div class="docs-article-header">
        <h1 dir="auto"><%= page ? page.title : project.name %></h1>

        <% if (page && page.content_updated) { %>
          <p class="docs-updated-date">
            <%= t('Last updated') %> <time datetime="<%= page.content_updated %>"><%= formatLongDateTime(page.content_updated, publicLocale) %></time>
          </p>
        <% } %>
      </div>

      <div class="docs-content prose" dir="auto" data-copy-label="<%= t('Copy code') %>">
        <%- contentHtml %>
      </div>

      <% if (typeof prevPage !== 'undefined' || typeof nextPage !== 'undefined') { %>
        <nav class="docs-pagination" aria-label="<%= t('Documentation pages') %>">
          <% if (typeof prevPage !== 'undefined' && prevPage) { %>
            <a href="<% if (_nonVersionedMode) { %>/docs/<%= project.slug %>/<%= prevPage.slug %><% } else { %>/docs/<%= project.slug %>/<%= version.slug %>/<%= prevPage.slug %><% } %>" class="docs-pagination-link prev">
              <i class="ph ph-arrow-left" aria-hidden="true"></i>

              <div>
                <span class="docs-pagination-label"><%= t('Previous') %></span>
                <span class="docs-pagination-title" dir="auto"><%= prevPage.title %></span>
              </div>
            </a>
          <% } %>

          <% if (typeof nextPage !== 'undefined' && nextPage) { %>
            <a href="<% if (_nonVersionedMode) { %>/docs/<%= project.slug %>/<%= nextPage.slug %><% } else { %>/docs/<%= project.slug %>/<%= version.slug %>/<%= nextPage.slug %><% } %>" class="docs-pagination-link next">
              <div>
                <span class="docs-pagination-label"><%= t('Next') %></span>
                <span class="docs-pagination-title" dir="auto"><%= nextPage.title %></span>
              </div>

              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          <% } %>
        </nav>
      <% } %>
    </article>

    <% if (typeof headings !== 'undefined' && headings.length > 0) { %>
      <aside class="docs-toc" aria-label="<%= t('On this page') %>">
        <h2 class="docs-toc-title"><%= t('On this page') %></h2>

        <ul>
          <% for (const h of headings) { %>
            <li class="toc-h<%= h.level %>">
              <a href="#<%= h.id %>">
                <bdi><%= h.text %></bdi>
              </a>
            </li>
          <% } %>
        </ul>
      </aside>
    <% } %>
  </div>
</div>

<script src="<%= assetUrl('/js/search.js') %>"></script>

<script src="<%= assetUrl('/js/version-switcher.js') %>"></script>

<script src="<%= assetUrl('/js/code-copy.js') %>"></script>

<script src="<%= assetUrl('/js/docs-toc.js') %>"></script>

<script src="<%= assetUrl('/js/markdown-checkboxes.js') %>"></script>

<script type="module" src="<%= assetUrl('/js/mermaid-init.js') %>"></script>
