<div class="projects-page">
  <% if (projects.length === 0) { %>
    <div class="empty-state">
      <% if (typeof search !== 'undefined' && search) { %>
        <h2>No matching projects</h2>
        <p>No projects found for "<%= search %>". <a href="/admin/projects">Clear search</a></p>
      <% } else { %>
        <h2>No projects yet</h2>
        <p>Create your first documentation project.</p>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap pb-table-wrap">
      <table class="data-table pb-data-table">
        <thead>
          <tr>
            <th>Project</th>
            <th>Slug</th>
            <th>Visibility</th>
            <th>Created</th>
            <th class="pb-arrow-column"></th>
          </tr>
        </thead>
        <tbody id="projectsList" data-load-more-list>
          <% for (const proj of projects) { %>
            <tr class="row-link" data-load-more-item="<%= proj.id %>" data-row-link="/admin/projects/<%= proj.id %>" tabindex="0" aria-label="Open project <%= proj.name %>">
              <td>
                <div class="table-project-cell">
                  <span><%= proj.name %></span>
                </div>
              </td>
              <td>
                <code><%= proj.slug %></code>
              </td>
              <td>
                <span class="badge badge-<%= proj.visibility %>"><%= proj.visibility %></span>
              </td>
              <td><%= formatDate(proj.created) %></td>
              <td class="pb-arrow-column">
                <i class="ph ph-arrow-right"></i>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <%- include('../../partials/load-more', { pagination, search: typeof search !== 'undefined' ? search : '', listId: 'projectsList' }) %>
  <% } %>
</div>
