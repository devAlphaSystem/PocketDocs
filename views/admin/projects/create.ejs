<div class="form-page">
  <div class="page-header">
    <div>
      <a href="/admin/projects" class="back-link"><i class="ph ph-arrow-left"></i> Projects</a>
    </div>

    <div class="header-actions">
      <a href="/admin/projects" class="btn btn-outline">Cancel</a>
      <button type="submit" form="project-create-form" class="btn btn-primary" id="manual-submit-btn"><i class="ph ph-plus"></i> Create Project</button>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><i class="ph ph-warning-circle"></i> <%= error %></div>
  <% } %>

  <form method="POST" action="/admin/projects/create" novalidate id="project-create-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="name">Project name <span class="required">*</span></label>
      <input type="text" id="name" name="name" placeholder="My Documentation" required maxlength="100" value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>" data-auto-slug-source data-auto-slug-target="slug">
      <p class="form-hint">A human-readable name for your project.</p>
    </div>

    <div class="form-group">
      <label for="slug">Slug <span class="required">*</span></label>

      <div class="input-prefix-wrap">
        <span class="input-prefix">/docs/</span>
        <input type="text" id="slug" name="slug" placeholder="my-docs" required maxlength="80" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" value="<%= typeof values !== 'undefined' && values.slug ? values.slug : '' %>">
      </div>

      <p class="form-hint">URL-safe identifier. Lowercase letters, numbers, and hyphens only.</p>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" class="textarea-description" rows="3" placeholder="Describe what this project documents..." maxlength="500"><%= typeof values !== 'undefined' && values.description ? values.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="visibility">Visibility</label>
      <select id="visibility" name="visibility">
        <option value="public"<%= typeof values === 'undefined' || !values.visibility || values.visibility === 'public' ? ' selected' : '' %>>Public</option>
        <option value="private"<%= typeof values !== 'undefined' && values.visibility === 'private' ? ' selected' : '' %>>Private</option>
      </select>
    </div>

    <div class="form-group">
      <label for="mode">Project type</label>
      <select id="mode" name="mode">
        <option value="versioned"<%= typeof values === 'undefined' || !values.mode || values.mode === 'versioned' ? ' selected' : '' %>>Versioned (with version history)</option>
        <option value="non_versioned"<%= typeof values !== 'undefined' && values.mode === 'non_versioned' ? ' selected' : '' %>>Non-Versioned</option>
      </select>

      <p class="form-hint">Versioned projects support release history and changelogs. Non-Versioned projects use one internal default version.</p>
    </div>
  </form>
</div>
