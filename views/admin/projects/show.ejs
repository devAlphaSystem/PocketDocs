<% const _projectMode = project.mode || 'versioned'; %>

<% const _singleVersionMode = _projectMode === 'non_versioned'; %>

<% const _pages = typeof pages !== 'undefined' ? pages : []; %>

<% const _defaultVersion = typeof defaultVersion !== 'undefined' ? defaultVersion : null; %>

<% const _versions = typeof versions !== 'undefined' ? versions : []; %>

<div class="project-detail">
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><i class="ph ph-check-circle"></i> <%= success %></div>
  <% } %>

  <% if (_singleVersionMode) { %>
    <% if (!_defaultVersion) { %>
      <div class="empty-state small">
        <div class="empty-icon">
          <i class="ph ph-warning-circle"></i>
        </div>
        <h3>Setup incomplete</h3>
        <p>No internal default version found for this project. Please delete and recreate it.</p>
      </div>
    <% } else if (_pages.length === 0) { %>
      <div class="empty-state small">
        <% if (typeof search !== 'undefined' && search) { %>
          <h3>No matching pages</h3>
          <p>No pages found for "<%= search %>". <a href="/admin/projects/<%= project.id %>">Clear search</a></p>
        <% } else { %>
          <h3>No pages yet</h3>
          <p>Create your first page to start writing.</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="versions-list" id="projectPagesList" data-load-more-list>
        <% for (const pg of _pages) { %>
          <div class="version-card row-link" data-load-more-item="<%= pg.id %>" data-row-link="/admin/projects/<%= project.id %>/versions/<%= _defaultVersion.id %>/pages/<%= pg.id %>" data-drawer-url="/admin/projects/<%= project.id %>/versions/<%= _defaultVersion.id %>/pages/<%= pg.id %>" data-drawer-title="Edit Page" tabindex="0" aria-label="Edit page <%= pg.title %>">
            <div class="version-card-main">
              <div class="version-info">
                <h3>
                  <% if (pg.icon) { %>
                    <i class="ph ph-<%= pg.icon %>"></i> 
                  <% } %>
                  <%= pg.title %></h3>
                <span class="version-slug">/<%= pg.slug %></span>
              </div>

              <div class="version-actions">
                <a href="/admin/projects/<%= project.id %>/versions/<%= _defaultVersion.id %>/pages/<%= pg.id %>" class="btn btn-outline" data-drawer-url="/admin/projects/<%= project.id %>/versions/<%= _defaultVersion.id %>/pages/<%= pg.id %>" data-drawer-title="Edit Page"><i class="ph ph-pencil"></i> Edit</a>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <%- include('../../partials/load-more', { pagination, search: typeof search !== 'undefined' ? search : '', listId: 'projectPagesList' }) %>
    <% } %>
  <% } else { %>
    <% if (_versions.length === 0) { %>
      <div class="empty-state small">
        <% if (typeof search !== 'undefined' && search) { %>
          <h3>No matching versions</h3>
          <p>No versions found for "<%= search %>". <a href="/admin/projects/<%= project.id %>">Clear search</a></p>
        <% } else { %>
          <h3>No versions yet</h3>
          <p>Create your first version to start writing documentation.</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="versions-list pb-record-list" id="versionsList" data-load-more-list>
        <% for (const ver of _versions) { %>
          <div class="version-card row-link" data-load-more-item="<%= ver.id %>" data-row-link="/admin/projects/<%= project.id %>/versions/<%= ver.id %>/pages" tabindex="0" aria-label="Open version <%= ver.label %>">
            <div class="version-card-main">
              <div class="version-info">
                <h3><%= ver.label %></h3>
                <span class="version-slug">/<%= ver.slug %></span>

                <% if (ver.is_public) { %>
                  <span class="badge badge-public">Public</span>
                <% } else { %>
                  <span class="badge badge-draft">Draft</span>
                <% } %>
              </div>

              <div class="version-actions">
                <a href="/admin/projects/<%= project.id %>/versions/<%= ver.id %>/pages" class="btn btn-row-action" title="Content" aria-label="Open content for <%= ver.label %>">
                  <i class="ph ph-files"></i>
                </a>
                <a href="/admin/projects/<%= project.id %>/versions/<%= ver.id %>/changelog" class="btn btn-row-action" title="Changelog" data-drawer-url="/admin/projects/<%= project.id %>/versions/<%= ver.id %>/changelog" data-drawer-title="Edit Changelog" aria-label="Edit changelog for <%= ver.label %>">
                  <i class="ph ph-clock-counter-clockwise"></i>
                </a>
                <a href="/admin/projects/<%= project.id %>/versions/<%= ver.id %>/edit" class="btn btn-row-action" title="Edit" data-drawer-url="/admin/projects/<%= project.id %>/versions/<%= ver.id %>/edit" data-drawer-title="Edit Version" aria-label="Edit <%= ver.label %>">
                  <i class="ph ph-pencil"></i>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <%- include('../../partials/load-more', { pagination, search: typeof search !== 'undefined' ? search : '', listId: 'versionsList' }) %>
    <% } %>
  <% } %>
</div>
