<div class="form-page">
  <form method="POST" action="/admin/settings" id="settings-form" class="settings-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="settings-application">
      <details class="accordion" name="settings-options">
        <summary>
          <i class="ph ph-house" aria-hidden="true"></i>
          <span>Public site</span>
        </summary>

        <div class="settings-accordion-body">
          <div class="settings-field-grid">
            <div class="form-group pb-form-field settings-icon-field">
              <label for="siteIconFile">Icon</label>

              <div class="settings-icon-control">
                <span class="settings-icon-preview">
                  <img src="<%= siteIconUrl %>" alt="" data-site-icon-preview data-default-src="<%= assetUrl('/img/pd-logo.svg') %>">
                </span>

                <div class="settings-icon-actions">
                  <input type="file" id="siteIconFile" accept="image/svg+xml,image/png,image/jpeg,image/webp" data-site-icon-file>
                  <input type="hidden" id="siteIcon" name="siteIcon" value="" data-site-icon-value>
                  <input type="hidden" name="removeSiteIcon" value="false" data-site-icon-remove>
                  <button type="button" class="btn btn-outline btn-sm" data-site-icon-reset <%= hasCustomSiteIcon ? '' : 'hidden' %>>Use default icon</button>
                </div>
              </div>

              <p class="form-hint">SVG, PNG, JPEG or WebP, up to 256 KB. Used in the browser tab, public header and homepage hero.</p>
            </div>

            <div class="form-group pb-form-field settings-markdown-field">
              <label for="heroTitle">Title <span class="required">*</span></label>
              <textarea id="heroTitle" name="heroTitle" rows="2" required maxlength="200" placeholder="e.g. Acme **Docs**"><%= settings.heroTitle %></textarea>
              <p class="form-hint">Supports inline Markdown such as <code>**bold**</code>, <code>*italic*</code>, links and inline code.</p>
            </div>

            <div class="form-group pb-form-field settings-markdown-field">
              <label for="heroSubtitle">Subtitle</label>
              <textarea id="heroSubtitle" name="heroSubtitle" rows="2" maxlength="300" placeholder="e.g. Documentation for **your team**."><%= settings.heroSubtitle %></textarea>
              <p class="form-hint">Supports inline Markdown such as <code>**bold**</code>, <code>*italic*</code>, links and inline code.</p>
            </div>
          </div>
        </div>
      </details>

      <% if (canManageIpRestriction) { %>
        <details class="accordion" name="settings-options">
          <summary>
            <i class="ph ph-shield-check" aria-hidden="true"></i>
            <span>Admin IP restriction</span>
            <span class="badge badge-<%= ipRestriction.enabled === 'enable' ? 'public' : 'private' %>" data-ip-status-badge><%= ipRestriction.enabled === 'enable' ? 'Enabled' : 'Disabled' %></span>
          </summary>

          <div class="settings-accordion-body">
            <input type="hidden" id="ipEnabled" name="enabled" value="<%= ipRestriction.enabled %>">
            <label class="settings-toggle-row" for="ipEnabledToggle">
              <span class="settings-switch">
                <input type="checkbox" id="ipEnabledToggle" role="switch" aria-checked="<%= ipRestriction.enabled === 'enable' ? 'true' : 'false' %>" data-value-target="ipEnabled" <%= ipRestriction.enabled === 'enable' ? 'checked' : '' %>>
                <span class="settings-switch-track" aria-hidden="true"></span>
              </span>
              <span>Enable</span>
            </label>

            <div class="form-group pb-form-field settings-ips-field">
              <label for="allowedIps">Allowed IPs</label>
              <textarea id="allowedIps" name="allowedIps" rows="9" maxlength="5000" placeholder="e.g. 127.0.0.1&#10;192.168.1.100&#10;10.0.0.5"><%= ipRestriction.allowedIps %></textarea>
            </div>

            <div class="settings-field-hints">
              <p class="form-hint">Enter one IP address per line. IPv4 and IPv6 are supported.</p>

              <% if (detectedIp) { %>
                <p class="form-hint"><strong>Your current IP:</strong> <a href="#" id="insert-my-ip" data-ip="<%= detectedIp %>">
                    <code><%= detectedIp %></code>
                  </a> — click to add to the list above.</p>
              <% } %>
            </div>
          </div>
        </details>
      <% } %>
    </div>

    <div class="form-submit-row">
      <button type="submit" class="btn btn-primary">
        <i class="ph ph-floppy-disk"></i>
        Save changes
      </button>
    </div>
  </form>
</div>
